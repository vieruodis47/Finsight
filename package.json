{
  "name": "finsight",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev-frontend": "npm run dev --prefix frontend",
    "dev-backend": "npm run dev --prefix backend",
    "dev-python": "python -m uvicorn backend.data_extract.app:app --reload --port 8000",
    "dev": "concurrently -n vite,node,python -c cyan,green,yellow \"npm run dev-frontend\" \"npm run dev-backend\" \"npm run dev-python\"",
    "build": "npm run build --prefix frontend",
    "start": "npm run start --prefix backend"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
